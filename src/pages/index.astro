---
import "../styles/landing.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Wren is an EVM wallet and signing firewall for browsers and native apps."
    />
    <meta name="theme-color" content="#070907" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Wren" />
    <meta property="og:title" content="Wren | EVM wallet and signing firewall" />
    <meta
      property="og:description"
      content="An EVM wallet and signing firewall for browsers and native apps."
    />
    <meta property="og:url" content="https://getwren.xyz/" />
    <meta property="og:image" content="https://getwren.xyz/og-wren-v2.png" />
    <meta property="og:image:secure_url" content="https://getwren.xyz/og-wren-v2.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Wren wallet and signing firewall over a pixel-art forest stream with a wren on a fallen log."
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Wren | EVM wallet and signing firewall" />
    <meta
      name="twitter:description"
      content="An EVM wallet and signing firewall for browsers and native apps."
    />
    <meta name="twitter:image" content="https://getwren.xyz/og-wren-v2.png" />
    <meta
      name="twitter:image:alt"
      content="Wren wallet and signing firewall over a pixel-art forest stream with a wren on a fallen log."
    />

    <title>Wren | EVM wallet and signing firewall</title>
    <link rel="canonical" href="https://getwren.xyz/" />
    <link rel="icon" href="/assets/wren-favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/assets/wren-apple-touch-icon-180.png" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="Wren home">
          <img src="/assets/wren-mark.svg" alt="" />
          <span>wren</span>
        </a>

        <nav class="nav" aria-label="Primary navigation">
          <a href="https://github.com/jorphex/wren/releases" target="_blank" rel="noopener noreferrer">Releases</a>
          <a href="/docs/">Docs</a>
          <a
            href="https://github.com/jorphex/wren"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Wren on GitHub"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.11.79-.25.79-.56v-2.24c-3.22.7-3.9-1.37-3.9-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.72 1.27 3.38.97.1-.75.4-1.27.74-1.56-2.57-.29-5.27-1.29-5.27-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.47.11-3.05 0 0 .97-.31 3.16 1.18A10.96 10.96 0 0 1 12 6.11c.98 0 1.95.13 2.87.39 2.2-1.49 3.16-1.18 3.16-1.18.63 1.58.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.4-2.71 5.38-5.29 5.67.42.36.79 1.06.79 2.14v3.28c0 .31.21.68.8.56A11.5 11.5 0 0 0 12 .7Z" />
            </svg>
          </a>
          <a
            href="https://x.com/jxyhelper"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Wren on X"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M18.9 2H22l-6.77 7.74L23.2 22h-6.24l-4.89-6.39L6.48 22H3.36l7.26-8.3L2.98 2h6.4l4.42 5.84L18.9 2Zm-1.1 17.84h1.73L8.44 4.05H6.58L17.8 19.84Z" />
            </svg>
          </a>
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-inner">
          <div class="hero-copy">
            <h1 id="hero-title">wren</h1>
            <p class="tagline">An EVM wallet and signing firewall<br />for browsers and native apps.</p>
            <p class="status mono">Linux x64 · GPL v3.0</p>
            <div class="actions">
              <a
                class="button button-primary"
                href="https://github.com/jorphex/wren/releases"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.11.79-.25.79-.56v-2.24c-3.22.7-3.9-1.37-3.9-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.72 1.27 3.38.97.1-.75.4-1.27.74-1.56-2.57-.29-5.27-1.29-5.27-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.47.11-3.05 0 0 .97-.31 3.16 1.18A10.96 10.96 0 0 1 12 6.11c.98 0 1.95.13 2.87.39 2.2-1.49 3.16-1.18 3.16-1.18.63 1.58.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.4-2.71 5.38-5.29 5.67.42.36.79 1.06.79 2.14v3.28c0 .31.21.68.8.56A11.5 11.5 0 0 0 12 .7Z" />
                </svg>
                <span data-platform-release-label>View releases</span>
              </a>
              <a
                class="button button-secondary"
                href="https://github.com/jorphex/wren-companion/releases"
                target="_blank"
                rel="noopener noreferrer"
              >Browser companion</a>
            </div>
          </div>

          <figure class="wallet-preview">
            <img
              src="/assets/wren-transaction-review.png"
              alt="Wren reviewing a 1 ETH transfer with completed simulation and a possible address-poisoning warning."
              width="930"
              height="1350"
            />
          </figure>
        </div>
      </section>

      <div class="main-content">
        <section class="section" aria-label="Core capabilities">
          <div class="content">
            <div class="capabilities">
              <article class="capability">
                <h2>Review every request</h2>
                <p>Read calldata and typed data. Simulation is evidence, not a guarantee.</p>
              </article>
              <article class="capability">
                <h2>Keep permissions scoped</h2>
                <p>Grant and revoke accounts, methods, and network routes per origin.</p>
              </article>
              <article class="capability">
                <h2>Keep keys local</h2>
                <p>Use hardware or encrypted local software signers. Watch-only accounts cannot sign.</p>
              </article>
            </div>
          </div>
        </section>

        <section class="section" aria-label="Connection and privacy boundaries">
          <div class="content evidence-grid">
            <div class="evidence-block">
              <h2>Same controls, every app</h2>
              <p class="lede">Browser and native apps share one review model, with support for EIP-1193, EIP-712, and SIWE.</p>
              <a class="text-link" href="/docs/getting-started/companion/">Browser connection guide</a>
            </div>

            <div class="evidence-block">
              <h2>No first-party backend</h2>
              <p class="lede">Wren has no first-party hosted backend. Requests go to configured endpoints. Docs lists the defaults and data each service can receive.</p>
              <a class="text-link" href="/docs/">Read the data map</a>
            </div>
          </div>

          <div class="content">
            <div class="endpoint-register" aria-label="Default endpoints">
              <p class="endpoint-label">Default endpoints</p>
              <div class="endpoint-item">
                <span class="endpoint-service">PublicNode</span>
                <span class="endpoint-purpose">EVM RPC</span>
              </div>
              <div class="endpoint-item">
                <span class="endpoint-service">DefiLlama</span>
                <span class="endpoint-purpose">USD pricing</span>
              </div>
              <div class="endpoint-item">
                <span class="endpoint-service">ipfs.io</span>
                <span class="endpoint-purpose">Pinned Send content</span>
              </div>
              <div class="endpoint-item">
                <span class="endpoint-service">Yearn Kong</span>
                <span class="endpoint-purpose">Earn catalog</span>
              </div>
            </div>
          </div>
        </section>

        <section class="section" aria-labelledby="start-title">
          <div class="content">
            <div class="get-started">
              <div>
                <h2 id="start-title">Install Wren</h2>
                <p>Wren is for Linux. Check signer support and release limitations before installing.</p>
              </div>
              <div class="actions">
                <a
                  class="button button-primary"
                  href="https://github.com/jorphex/wren/releases"
                  target="_blank"
                  rel="noopener noreferrer"
                ><span data-platform-release-label>View releases</span></a>
                <a class="button button-secondary" href="/docs/getting-started/install/">Installation guide</a>
              </div>
            </div>
          </div>
        </section>
      </div>
    </main>

    <footer>
      <div class="footer-inner">
        <div class="footer-note">
          <img src="/assets/wren-mark.svg" alt="" />
          <span><strong>wren</strong> · A community-maintained continuation of Frame wallet · GNU GPL v3.0</span>
        </div>
        <div class="footer-actions">
          <div
            class="footer-support"
            data-footer-support
            data-support-address="0x6ac7F5A89E2eC6c30Aa687F9f2117bA1E31D0D97"
          >
            <button
              class="footer-support-toggle"
              type="button"
              aria-expanded="false"
              aria-controls="footer-support-panel"
            >Support wren</button>
            <div
              class="footer-support-panel"
              id="footer-support-panel"
              role="group"
              aria-label="Support Wren"
              hidden
            >
              <p>EVM donation address</p>
              <img
                src="/assets/wren-tip-qr.svg"
                alt="QR code for the Wren donation address."
                width="148"
                height="148"
              />
              <code>0x6ac7F5A89E2eC6c30Aa687F9f2117bA1E31D0D97</code>
              <button class="footer-support-copy" type="button" data-copy-address>Copy address</button>
              <span class="sr-only" aria-live="polite" data-copy-status></span>
            </div>
          </div>
          <nav class="footer-links" aria-label="Footer navigation">
            <a href="https://github.com/jorphex/wren/releases" target="_blank" rel="noopener noreferrer">Releases</a>
            <a href="/docs/">Docs</a>
            <a href="https://github.com/jorphex/wren" target="_blank" rel="noopener noreferrer">GitHub</a>
            <a href="https://x.com/jxyhelper" target="_blank" rel="noopener noreferrer">X</a>
          </nav>
        </div>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const userAgentData = navigator.userAgentData;
        const userAgent = navigator.userAgent || "";
        const platform = userAgentData?.platform || navigator.platform || userAgent;
        const isMobile = userAgentData?.mobile || /Android|iPhone|iPad|iPod|Mobile/i.test(userAgent);

        const platformKey = /Linux/i.test(platform)
          ? "linux"
          : /Mac/i.test(platform)
            ? "macos"
            : /Win/i.test(platform)
              ? "windows"
              : "unknown";

        const releases = {
          linux: { available: true, label: "Download for Linux" },
          macos: { available: false, label: "Download for macOS" },
          windows: { available: false, label: "Download for Windows" },
        };

        const release = releases[platformKey];
        if (isMobile || !release?.available) return;

        document.querySelectorAll("[data-platform-release-label]").forEach((label) => {
          label.textContent = release.label;
        });
      })();
    </script>
    <script is:inline>
      (() => {
        const support = document.querySelector("[data-footer-support]");
        const toggle = support?.querySelector(".footer-support-toggle");
        const panel = support?.querySelector(".footer-support-panel");
        const copyButton = support?.querySelector("[data-copy-address]");
        const status = support?.querySelector("[data-copy-status]");
        const address = support?.dataset.supportAddress;

        if (!support || !toggle || !panel || !copyButton || !status || !address) return;

        const setOpen = (open) => {
          toggle.setAttribute("aria-expanded", String(open));
          panel.hidden = !open;
        };

        toggle.addEventListener("click", () => {
          setOpen(toggle.getAttribute("aria-expanded") !== "true");
        });

        document.addEventListener("click", (event) => {
          if (!support.contains(event.target)) setOpen(false);
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
            setOpen(false);
            toggle.focus();
          }
        });

        copyButton.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(address);
            copyButton.textContent = "Copied";
            status.textContent = "Donation address copied.";
          } catch {
            copyButton.textContent = "Copy failed";
            status.textContent = "Copy failed. Select the address and copy it manually.";
          }

          window.setTimeout(() => {
            copyButton.textContent = "Copy address";
            status.textContent = "";
          }, 1500);
        });
      })();
    </script>
  </body>
</html>
